FLASK_ENV=development
FLASK_DEBUG=true

HOST=0.0.0.0
PORT=8000

# JWT (obligatoriu pt login)
JWT_SECRET_KEY=change-me

# DB (SQLite local)
DATABASE_URL=sqlite:///healthybyte.db

# Nutrition API 
NODE_PATH=/path/to/node
MCP_OPENNUTRITION_PATH=/path/to/mcp-opennutrition/build/index.js

AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_LANGUAGE=en

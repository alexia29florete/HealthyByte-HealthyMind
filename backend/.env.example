# Flask
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Database
DATABASE_URL=sqlite:///healthybyte.db

# Optional: Edamam Nutrition Analysis API
# https://developer.edamam.com/edamam-nutrition-api
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# OpenAI / AI integration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

# MCP OpenNutrition (optional, only if you use ai/smart_analyzer.py)
MCP_OPENNUTRITION_PATH=
NODE_PATH=node
